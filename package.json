{
  "name": "pi-zk",
  "version": "0.1.4",
  "description": "Pi extension exposing the zk note-taking CLI as agent-native tools.",
  "type": "module",
  "license": "MIT",
  "author": "Raphael Ribeiro",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "zk",
    "zettelkasten",
    "notes",
    "neovim"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/raphapr/pi-zk/main/assets/pi-zk-gallery.png"
  },
  "files": [
    "dist/",
    "src/",
    "assets/",
    "README.md",
    "LICENSE",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.mjs",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --external:@earendil-works/* --external:typebox --outfile=dist/index.ts",
    "prepack": "npm run build",
    "validate": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raphapr/pi-zk.git"
  },
  "homepage": "https://github.com/raphapr/pi-zk#readme",
  "bugs": {
    "url": "https://github.com/raphapr/pi-zk/issues"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
